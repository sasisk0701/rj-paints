datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
}

enum BusinessType {
  PAINTS
  INTERIORS
  BOTH
}

model AdminUser {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      Role      @default(ADMIN)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Product {
  id            String       @id @default(uuid())
  name          String
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id])
  categoryName  String
  brand         String
  sku           String       @unique
  barcode       String       @unique
  description   String?      @db.Text
  purchasePrice Float
  sellingPrice  Float
  gstRate       Float        @default(18.0)
  stock         Int          @default(0)
  minStock      Int          @default(5)
  unit          String       @default("Liter")
  image         String?
  business      BusinessType @default(PAINTS)
  status        String       @default("In Stock")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  stockInItems     StockInItem[]
  stockOutItems    StockOutItem[]
  stockAdjustments StockAdjustmentItem[]
  purchaseItems    PurchaseItem[]
  saleItems        SaleItem[]
}

model Category {
  id          String       @id @default(uuid())
  name        String
  business    BusinessType @default(PAINTS)
  description String?      @db.Text
  color       String       @default("#6B7280")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  products    Product[]
}

model Supplier {
  id                 String        @id @default(uuid())
  name               String
  gstNumber          String        @unique
  phone              String
  email              String?
  address            String?
  city               String
  business           BusinessType  @default(PAINTS)
  outstandingBalance Float         @default(0.0)
  notes              String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  stockInRecords     StockInRecord[]
  purchases          Purchase[]
}

model StockInRecord {
  id           String        @id @default(uuid())
  invoiceNo    String        @unique
  supplierId   String?
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  supplierName String
  purchaseDate DateTime
  subtotal     Float
  totalGst     Float
  grandTotal   Float
  paymentMode  String
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  items        StockInItem[]
}

model StockInItem {
  id            String        @id @default(uuid())
  stockInId     String
  stockInRecord StockInRecord @relation(fields: [stockInId], references: [id], onDelete: Cascade)
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  quantity      Int
  purchasePrice Float
  gstRate       Float
  total         Float
}

model StockOutRecord {
  id            String         @id @default(uuid())
  invoiceNo     String         @unique
  customerName  String
  customerPhone String
  saleDate      DateTime
  subtotal      Float
  discountTotal Float          @default(0.0)
  totalGst      Float
  grandTotal    Float
  paymentMode   String
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items         StockOutItem[]
}

model StockOutItem {
  id             String         @id @default(uuid())
  stockOutId     String
  stockOutRecord StockOutRecord @relation(fields: [stockOutId], references: [id], onDelete: Cascade)
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  quantity       Int
  sellingPrice   Float
  discount       Float          @default(0.0)
  gstRate        Float
  total          Float
}

model StockAdjustmentRecord {
  id             String                @id @default(uuid())
  referenceNo    String                @unique
  adjustmentDate DateTime
  business       BusinessType
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  items          StockAdjustmentItem[]
}

model StockAdjustmentItem {
  id                    String                @id @default(uuid())
  stockAdjustmentId     String
  stockAdjustmentRecord StockAdjustmentRecord @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  productId             String
  product               Product               @relation(fields: [productId], references: [id])
  systemStock           Int
  physicalCount         Int
  difference            Int
  notes                 String?
}

model Purchase {
  id           String        @id @default(uuid())
  poNumber     String        @unique
  supplierId   String?
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  supplierName String
  purchaseDate DateTime
  paymentMode  String
  status       String        @default("Pending")
  subtotal     Float         @default(0)
  gstAmount    Float         @default(0)
  totalAmount  Float         @default(0)
  notes        String?       @db.Text
  business     BusinessType  @default(PAINTS)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  items        PurchaseItem[]
}

model PurchaseItem {
  id            String   @id @default(uuid())
  purchaseId    String
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  productName   String
  quantity      Int
  purchasePrice Float
  gstRate       Float    @default(18)
  amount        Float
}

model Sale {
  id             String       @id @default(uuid())
  invoiceNumber  String       @unique
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  customerName   String
  customerPhone  String
  saleDate       DateTime
  paymentMode    String
  status         String       @default("Paid")
  subtotal       Float        @default(0)
  discountAmount Float        @default(0)
  gstAmount      Float        @default(0)
  totalAmount    Float        @default(0)
  notes          String?      @db.Text
  business       BusinessType @default(PAINTS)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  items          SaleItem[]
}

model SaleItem {
  id           String  @id @default(uuid())
  saleId       String
  sale         Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  productName  String
  quantity     Int
  sellingPrice Float
  discount     Float   @default(0)
  gstRate      Float   @default(18)
  amount       Float
}

model Quotation {
  id             String         @id @default(uuid())
  quoteNumber    String         @unique
  customerName   String
  customerPhone  String
  customerEmail  String?
  validUntil     DateTime
  status         String         @default("Draft")
  subtotal       Float          @default(0)
  discountAmount Float          @default(0)
  gstAmount      Float          @default(0)
  totalAmount    Float          @default(0)
  notes          String?        @db.Text
  terms          String?        @db.Text
  business       BusinessType   @default(PAINTS)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  items          QuotationItem[]
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String?
  description String
  quantity    Int
  unitPrice   Float
  discount    Float     @default(0)
  gstRate     Float     @default(18)
  amount      Float
}

model Customer {
  id                 String       @id @default(uuid())
  name               String
  phone              String
  email              String?
  address            String?
  city               String
  business           BusinessType @default(PAINTS)
  creditLimit        Float        @default(0.0)
  outstandingBalance Float        @default(0.0)
  notes              String?      @db.Text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  sales              Sale[]
}

model Expense {
  id          String       @id @default(uuid())
  category    String
  title       String
  amount      Float
  paymentMode String
  expenseDate DateTime
  remarks     String?
  business    BusinessType @default(PAINTS)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model BankAccount {
  id             String            @id @default(uuid())
  accountName    String
  bankName       String
  accountNumber  String            @unique
  ifscCode       String
  currentBalance Float             @default(0)
  type           String            @default("Current")
  business       BusinessType      @default(PAINTS)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  transactions   BankTransaction[]
}

model BankTransaction {
  id            String      @id @default(uuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  date          DateTime
  type          String
  description   String
  amount        Float
  direction     String
  reference     String?
  createdAt     DateTime    @default(now())
}

model CashTransaction {
  id          String       @id @default(uuid())
  date        DateTime
  type        String
  description String
  amount      Float
  direction   String
  business    BusinessType @default(PAINTS)
  reference   String?
  createdAt   DateTime     @default(now())
}

model PaymentRecord {
  id          String       @id @default(uuid())
  refNumber   String       @unique
  date        DateTime
  type        String
  party       String
  paymentMode String
  amount      Float
  notes       String?
  business    BusinessType @default(PAINTS)
  createdAt   DateTime     @default(now())
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  userName  String
  action    String
  module    String
  reference String?
  business  String   @default("paints")
  createdAt DateTime @default(now())
}
